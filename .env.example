# Required - Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional AWS S3 Storage (uses local storage if not provided)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=socialpulse-bucket

# Optional Search API for research (uses fallback if not provided)
SEARCH_API_KEY=your_search_api_key

# Optional LangSmith for monitoring
LANGSMITH_API_KEY=your_langsmith_key

# Demo Mode (set to true if APIs unavailable)
DEMO_MODE=false

# Application settings
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=10